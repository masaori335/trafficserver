// header_rewrite's rule_empty_body.conf, on the error ATS sends for a dead origin: a cript that
// sets an error itself skips all later hooks, so it can't set the body for that error.

#include <cripts/Preamble.hpp>

do_send_response()
{
  borrow url  = cripts::Client::URL::Get();
  borrow resp = cripts::Client::Response::Get();

  if (url.path == "body/empty") {
    resp.body = "";
  }
}

#include <cripts/Epilogue.hpp>
