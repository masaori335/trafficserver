// Reading certificates on a plaintext connection must give empty values. The
// TLS library must never receive a NULL SSL object.

#include <cripts/Preamble.hpp>

do_send_response()
{
  borrow     conn = cripts::Client::Connection::Get();
  borrow     resp = cripts::Client::Response::Get();
  const auto cert = cripts::Certs::Server(conn);
  const auto mtls = cripts::Certs::Client(conn);

  resp["X-Plain-Server-Cert"] = cert.subject.GetSV().empty() ? "none" : "unexpected";
  resp["X-Plain-Client-Cert"] = mtls.subject.GetSV().empty() ? "none" : "unexpected";
}

#include <cripts/Epilogue.hpp>
